# Copy to .env and fill in. .env is gitignored — never commit real values.

PIPELINE_ENV=local
PIPELINE_LOG_LEVEL=INFO
PIPELINE_LOG_JSON=false

# Source API
PIPELINE_SOURCE_BASE_URL=https://web-api.tp.entsoe.eu/api
PIPELINE_SOURCE_API_KEY=
PIPELINE_REQUEST_TIMEOUT_SECONDS=30
PIPELINE_MAX_RETRIES=5

# Storage
PIPELINE_DATA_DIR=data
PIPELINE_DUCKDB_PATH=data/warehouse/warehouse.duckdb

# Airflow (docker compose only)
AIRFLOW_UID=50000
